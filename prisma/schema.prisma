generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Як снапшоти JSON — манбаи ҳақиқии барнома (касса, анбор, CRM…).
/// Ҷадвалҳои алоҳидаи User/Product истифода намешаванд.
model AppSnapshot {
  id        String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}
