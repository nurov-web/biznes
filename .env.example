# Local JSON store is used in MVP (`data/app.json`).
# PostgreSQL (later): DATABASE_URL=postgresql://pilot:pilot@localhost:5432/businesspilot
DATABASE_URL="file:./dev.db"
# Vercel: JWT_SECRET тавсия мешавад. Агар набошад, build як калиди муваққатӣ месозад.
# Дар Vercel файли data/app.json навишта намешавад — /tmp ва cookie истифода мешавад.
JWT_SECRET="change-me-to-a-long-random-string"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Ҳамон калид барои ҷустуҷӯи веби Claude (скани бозори шаҳр). На парсинги Somon/OLX.
SMS_PROVIDER=demo
