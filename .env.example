# Маҳаллӣ: JSON (`data/app.json`). DATABASE_URL-ро холӣ гузоред, агар Postgres набошад.
# Vercel/Neon: postgresql://user:password@host/db?sslmode=require — баъд `npx prisma migrate deploy`.
# DATABASE_URL="postgresql://postgres:password@localhost:5432/businesspilot"
# Vercel: JWT_SECRET тавсия мешавад. Агар набошад, build як калиди муваққатӣ месозад.
JWT_SECRET="change-me-to-a-long-random-string"
# Калиди Anthropic Claude API (бояд бо sk-ant- сар шавад). Бе калид модели маҳаллӣ истифода мешавад.
# Anthropic Claude API key (must start with sk-ant-). Without a valid key, local fallback model is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Ҳамон калид барои ҷустуҷӯи веби Claude (скани бозори шаҳр). На парсинги Somon/OLX.
SMS_PROVIDER=demo
